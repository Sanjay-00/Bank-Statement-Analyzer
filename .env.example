# Copy this file to .env and fill in real values. .env is gitignored.

# Optional. Enables the Gemini Vision fallback (engine/ingest/vlm.py) for
# scanned pages Tesseract OCR still can't read (handwriting, skew, low
# resolution). Without it, those pages just stay flagged as scanned, same
# as before OCR/Vision existed - nothing breaks, you just lose that page's
# transactions. Reuse the key from the CIBIL_EXCEL project's own .env if
# you already have one.
GEMINI_API_KEY=

# Optional. Only needed if Tesseract isn't at the standard Windows install
# path (C:\Program Files\Tesseract-OCR\tesseract.exe) and isn't on PATH.
# TESSERACT_CMD=
